{
  "name": "morse-bridge",
  "version": "0.2.0",
  "description": "Minimal Telegram bot that lets you chat with the Codex CLI on your own machine. Bring your own bot token, run locally.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ehsuun/morse.git"
  },
  "homepage": "https://github.com/ehsuun/morse#readme",
  "bugs": {
    "url": "https://github.com/ehsuun/morse/issues"
  },
  "keywords": [
    "telegram",
    "agent",
    "codex",
    "cli",
    "local-first"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "morse": "./bot.mjs"
  },
  "files": [
    ".env.example",
    "approvals.mjs",
    "bot.mjs",
    "codex_app_server.mjs",
    "config.mjs",
    "helpers.mjs",
    "morse.png",
    "package_info.mjs",
    "session_state.mjs",
    "setup.mjs",
    "slash_commands.mjs",
    "telegram_auth.mjs",
    "websocket_proxy.mjs"
  ],
  "scripts": {
    "enable": "node bot.mjs enable",
    "start": "node bot.mjs",
    "status": "node bot.mjs status",
    "setup": "node bot.mjs setup",
    "test": "node tests/run.mjs",
    "test:integration": "node -e \"process.env.MORSE_INTEGRATION='1'; import('./tests/run.mjs')\"",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
