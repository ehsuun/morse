# Optional. Most people will never edit this file by hand — `npm start` runs an
# interactive setup on first launch and writes a real .env in this folder.
# This file is here as a reference for the keys and defaults.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated list of Telegram user IDs allowed to talk to the bot.
# Setup auto-detects yours from the first message you send to your bot.
ALLOWED_USER_IDS=

# Command used to run Codex non-interactively. The user message is appended as
# a single quoted argument. Override if your install uses a different binary or
# you want extra flags (e.g. "codex exec --model gpt-5-codex --skip-git-check").
CODEX_CMD=codex exec

# Working directory Codex runs in. Defaults to the directory the bot was
# launched from.
CODEX_CWD=

# Optional per-message timeout in seconds. 0 disables.
CODEX_TIMEOUT_SECONDS=600
