# Legacy fallback config. New setup writes global JSON config and per-session
# state instead:
#   Windows: %APPDATA%\morse\config.json
#   macOS/Linux: ~/.config/morse/config.json
#
# Keep this file only as a reference for older repo-local deployments. Most
# users should run `morse setup`, then `morse start` and `morse codex`.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated list of Telegram user IDs allowed to talk to the bot.
ALLOWED_USER_IDS=

# Optional comma-separated list of private Telegram chat IDs allowed to receive
# replies. New setup fills this automatically in global config.
ALLOWED_CHAT_IDS=

# Legacy fallback from older morse versions.
CODEX_CMD=codex resume --last

# Legacy app-server override. Current `morse codex` uses a random loopback port
# and writes the active session to state.json instead.
CODEX_APP_SERVER_URL=ws://127.0.0.1:17373
CODEX_APP_SERVER_CMD=codex app-server --listen ws://127.0.0.1:17373

# Working directory Codex runs in when using legacy .env mode.
CODEX_CWD=

# Optional per-message timeout in seconds. 0 disables.
CODEX_TIMEOUT_SECONDS=600

# Debounce interval for Telegram message edits.
STREAM_DEBOUNCE_MS=1200
